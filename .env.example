# Portable application home. By default this is <HFlow install>\runtime,
# so selecting another drive in the installer keeps all app-owned files there.
# Use this override for development or portable deployments:
# HFLOW_HOME=D:\HFlowData
# RUNTIME_DATA_DIR defaults to HFLOW_HOME\data; override only for migration.
# RUNTIME_DATA_DIR=D:\HFlowData

# Whisper transcription
# Models: tiny, base, small, medium, large-v3
WHISPER_MODEL=small

# HY-MT2 local machine translation. The model downloads into HF_HOME on first use.
HYMT2_MODEL=tencent/Hy-MT2-1.8B

# Edge TTS requests are sent concurrently. Keep this between 1 and 4.
TTS_MAX_CONCURRENCY=1

# Without HFLOW_HOME, advanced deployments may override individual caches.
# When HFLOW_HOME is set, it is a hard boundary and these are ignored so a
# machine-wide environment variable cannot silently redirect files to drive C.
# HF_HOME=D:\HFlowData\cache\huggingface
# TORCH_HOME=D:\HFlowData\cache\torch
# PIP_CACHE_DIR=D:\HFlowData\cache\pip
# UV_CACHE_DIR=D:\HFlowData\cache\uv
# HFLOW_TMP_DIR=D:\HFlowData\cache\tmp
